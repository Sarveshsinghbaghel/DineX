# Root workspace defaults
NODE_ENV=development

# Shared endpoints
X10THINK_API_BASE_URL=http://localhost:4000/api/v1
X10THINK_WEB_BASE_URL=http://localhost:5173

# Service ports
X10THINK_API_PORT=4000
X10THINK_WEB_PORT=5173
X10THINK_WORKER_PORT=4100

# Database
X10THINK_MONGODB_URI=mongodb://localhost:27017/x10think-dev
X10THINK_MONGODB_DB_NAME=x10think-dev

# Worker
X10THINK_WORKER_POLL_INTERVAL_MS=30000
