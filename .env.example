# DineX Root Environment Variables Template
NODE_ENV=development

# Service Ports
PORT=4000
WEB_PORT=5173
WORKER_PORT=4100

# API Configuration
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:5173

# Database Connection (MongoDB)
MONGODB_URI=mongodb://localhost:27017/dinex-dev

# JWT Authentication Secrets (Replace in production)
JWT_ACCESS_SECRET=dev_jwt_access_secret_32_characters_minimum
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_32_characters_minimum

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=dinex
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=dev_cloudinary_api_secret

# Rate Limiting
REQUEST_RATE_LIMIT_MAX=300

# Worker Polling
WORKER_POLL_INTERVAL_MS=30000
