{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "declaration": true,
    "paths": {
      "@x10think/configuration": ["packages/configuration/src/index.ts"],
      "@x10think/constants": ["packages/constants/src/index.ts"],
      "@x10think/types": ["packages/types/src/index.ts"],
      "@x10think/ui": ["packages/ui/src/index.ts"],
      "@x10think/utils": ["packages/utils/src/index.ts"],
      "@x10think/validation": ["packages/validation/src/index.ts"]
    }
  }
}
