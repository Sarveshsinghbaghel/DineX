# DineX API Environment Variables Template
NODE_ENV=development
APP_NAME=DineX Restaurant Management System API
APP_VERSION=0.1.0
PORT=4000
API_PREFIX=/api/v1
CLIENT_URL=http://localhost:5173

# Database Connection
MONGODB_URI=mongodb://localhost:27017/dinex-dev
MONGODB_DB_NAME=dinex-dev
DATABASE_STRICT_STARTUP=false

# Authentication Secrets
JWT_ACCESS_SECRET=dev_jwt_access_secret_32_characters_minimum
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_32_characters_minimum

# Cloudinary Credentials
CLOUDINARY_CLOUD_NAME=dinex
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=dev_cloudinary_api_secret

# Rate Limiting Controls
REQUEST_RATE_LIMIT_MAX=300
