    "@x10think/validation": "0.1.0",
    "compression": "^1.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.0.0",
    "dotenv": "^17.0.0",
    "express": "^5.0.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.0.0",
    "mongoose": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.1.0",
    "winston": "^3.0.0",
    "socket.io": "^4.8.0",
    "exceljs": "^4.4.0",
    "pdfkit": "^0.16.0",
    "zod": "^4.0.0"
